{
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "package": "svelte-kit package",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "lint:es": "eslint .",
    "format": "prettier --write .",
    "test": "node --import=./scripts/coverage-hooks.mjs --test 'tests/**/*.test.ts'",
    "test:coverage": "node --import=./scripts/coverage-hooks.mjs --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.d.ts' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test 'tests/**/*.test.ts'",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "test:performance": "PUBLIC_SUPABASE_URL=http://localhost PUBLIC_SUPABASE_PUBLISHABLE_KEY=placeholder pnpm run build && pnpm run check:performance",
    "test:e2e": "playwright test",
    "test:sanity": "playwright test --grep @sanity"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.113.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.1",
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0"
  }
}
